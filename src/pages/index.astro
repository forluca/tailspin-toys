---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games.flatMap((game) => game.category ? [[game.category.id, game.category] as const] : []),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher] as const] : []),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-6 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form class="flex flex-col gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-4 sm:flex-row sm:items-end" data-testid="game-filters">
          <fieldset class="flex flex-wrap gap-x-4 gap-y-2">
            <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid={`category-filter-${category.id}`}
                />
                {category.name}
              </label>
            ))}
          </fieldset>

          <label class="flex flex-col gap-2 text-sm text-slate-200">
            Publisher
            <select
              name="publisher"
              class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </label>

          <button
            type="button"
            class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="mb-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count">
            Showing {games.length} of {games.length} games.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" role="status" aria-live="polite" data-testid="no-filter-results">
            <EmptyState text="No games match these filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
  const categoryInputs = form?.querySelectorAll<HTMLInputElement>('input[name="category"]');
  const clearButton = form?.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

  if (!form || !grid || !resultCount || !noResults || !publisherSelect || !categoryInputs || !clearButton) {
    throw new Error('Game filters could not be initialized.');
  }

  const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  /** Applies the selected categories and publisher to the prerendered game cards. */
  const applyFilters = (): void => {
    const selectedCategories = new Set(
      Array.from(categoryInputs)
        .filter((input) => input.checked)
        .map((input) => input.value),
    );
    const selectedPublisher = publisherSelect.value;
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const matchesPublisher =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      card.hidden = !matchesCategory || !matchesPublisher;
      if (!card.hidden) visibleCount++;
    }

    resultCount.textContent = `Showing ${visibleCount} of ${cards.length} games.`;
    noResults.classList.toggle('hidden', visibleCount > 0);
  };

  form.addEventListener('change', applyFilters);
  clearButton.addEventListener('click', () => {
    form.reset();
    applyFilters();
  });
</script>
